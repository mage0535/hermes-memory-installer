#!/usr/bin/env python3
"""Emit cron execution heartbeat to metrics directory."""
import json, sys, os, time
from datetime import datetime, timezone
from pathlib import Path

name = sys.argv[1] if len(sys.argv) > 1 else "unknown"
status = "ok" if len(sys.argv) > 2 and sys.argv[2] == "0" else "failed"
outfile = Path(os.environ.get("AGENT_HOME", str(Path.home() / ".hermes"))) / "metrics" / "cron" / f"{name}-latest.json"
payload = {
    "name": name,
    "status": status,
    "timestamp": datetime.now(timezone.utc).isoformat(),
    "returncode": int(sys.argv[2]) if len(sys.argv) > 2 else -1
}
outfile.parent.mkdir(parents=True, exist_ok=True)
outfile.write_text(json.dumps(payload, ensure_ascii=False, indent=2))
